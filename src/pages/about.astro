---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, cta } from '../data/site';
import { about } from '../data/about';
import { focusAreas } from '../data/home';
import { skills, certifications } from '../data/education';
import { hero } from '../data/home';
---

<Base
  title="About"
  description="About Elijah W. Kim — 15+ years driving digital transformation where deep tech meets durable business value."
>
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[3fr_2fr]">
      <div>
        <p class="eyebrow">{about.eyebrow}</p>
        <h1
          class="mt-5 font-serif text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
        >
          {about.headingStart}<em class="italic text-accent"
            >{about.headingAccent}</em
          >{about.headingEnd}
        </h1>
        <div class="prose-body mt-8 max-w-2xl text-base leading-relaxed text-ink-soft">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={cta.href}
            class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent-deep"
          >
            {cta.label}
          </a>
          <a
            href={site.linkedin}
            rel="me noopener"
            target="_blank"
            class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
          >
            Connect on LinkedIn
          </a>
        </div>
      </div>

      <div class="space-y-10">
        <img
          src="/portrait.jpg"
          alt={hero.portraitAlt}
          width="800"
          height="1000"
          class="aspect-[4/5] w-full max-w-sm rounded-lg border border-line object-cover"
          loading="lazy"
        />

        <div>
          <p class="eyebrow mb-4">Certification</p>
          <ul class="space-y-2 text-sm text-ink-soft">
            {
              certifications.map((c) => (
                <li>
                  <span class="font-medium text-ink">{c.name}</span> — {c.detail}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="eyebrow mb-4">Top skills</p>
          <ul class="flex flex-wrap gap-2">
            {
              skills.map((skill) => (
                <li class="rounded border border-line bg-white/60 px-3 py-1 text-sm text-ink-soft">
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-deep">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8" data-reveal>
      <SectionHeading eyebrow="Focus areas" heading="Where I focus" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          focusAreas.map((area) => (
            <div class="rounded-lg border border-line bg-white/60 p-7">
              <h3 class="font-serif text-xl font-medium text-ink">
                {area.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                {area.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
