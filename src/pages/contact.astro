---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const hasScheduler = site.schedulerUrl.length > 0;
const hasForm = site.formspreeEndpoint.length > 0;
---

<Base
  title="Contact"
  description="Get in touch with Elijah W. Kim — quantum & AI engineer in Christchurch, New Zealand."
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="eyebrow">Contact</p>
    <h1
      class="mt-5 font-serif text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
    >
      Let's have a <em class="italic text-accent">conversation</em>.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Whether it's quantum readiness, an AI/ML product, or something at the
      edge of both — I'm happy to talk.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2" data-reveal>
      <div class="rounded-lg border border-line bg-white/60 p-8">
        <p class="eyebrow mb-3">Email</p>
        <a
          href={`mailto:${site.email}`}
          class="font-serif text-xl font-medium text-ink transition-colors hover:text-accent"
        >
          {site.email}
        </a>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          The most reliable way to reach me.
        </p>
      </div>

      <div class="rounded-lg border border-line bg-white/60 p-8">
        <p class="eyebrow mb-3">Book a conversation</p>
        {
          hasScheduler ? (
            <a
              href={site.schedulerUrl}
              rel="noopener"
              target="_blank"
              class="inline-block rounded-full bg-accent px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent-deep"
            >
              Open my calendar
            </a>
          ) : (
            <p class="text-sm leading-relaxed text-ink-soft">
              <span class="rounded border border-line bg-paper-deep px-2 py-0.5 text-xs uppercase tracking-wide">
                Placeholder
              </span>
              <span class="mt-2 block">
                Scheduler link coming soon — email me in the meantime and we'll
                find a time.
              </span>
            </p>
          )
        }
      </div>
    </div>

    <div class="mt-6 rounded-lg border border-line bg-white/60 p-8" data-reveal>
      <p class="eyebrow mb-3">Elsewhere</p>
      <a
        href={site.linkedin}
        rel="me noopener"
        target="_blank"
        class="text-sm font-medium text-accent underline underline-offset-4 hover:text-accent-deep"
      >
        LinkedIn — /in/eli-kim-4k
      </a>
    </div>

    {
      hasForm ? (
        <form
          action={site.formspreeEndpoint}
          method="POST"
          class="mt-6 rounded-lg border border-line bg-white/60 p-8"
          data-reveal
        >
          <p class="eyebrow mb-6">Or send a message</p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-ink">
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="mt-1.5 w-full rounded border border-line bg-paper px-3 py-2.5 text-sm focus:border-accent focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1.5 w-full rounded border border-line bg-paper px-3 py-2.5 text-sm focus:border-accent focus:outline-none"
              />
            </div>
          </div>
          <div class="mt-5">
            <label for="message" class="block text-sm font-medium text-ink">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-1.5 w-full rounded border border-line bg-paper px-3 py-2.5 text-sm focus:border-accent focus:outline-none"
            />
          </div>
          <button
            type="submit"
            class="mt-6 rounded-full bg-accent px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent-deep"
          >
            Send message
          </button>
        </form>
      ) : (
        <p class="mt-6 text-xs text-ink-soft">
          A contact form appears here once a Formspree endpoint is set in
          src/data/site.ts.
        </p>
      )
    }
  </section>
</Base>
