---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  tagline,
  problem,
  approach,
  role,
  tags,
  links,
  unconfirmed,
  image,
  imageAlt,
} = project.data;
const hasBody = (project.body ?? '').trim().length > 0;
---

<Base title={title} description={tagline}>
  <article class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24">
    <a
      href="/projects/"
      class="text-sm text-ink-soft transition-colors hover:text-accent"
    >
      ← All projects
    </a>

    <div class="mt-8 flex flex-wrap items-center gap-2">
      {
        unconfirmed && (
          <span class="rounded-full border border-line bg-paper-deep px-3 py-1 text-xs uppercase tracking-wide text-ink-soft">
            Draft — unconfirmed
          </span>
        )
      }
    </div>

    <h1
      class="mt-4 font-serif text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
    >
      {title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      {tagline}
    </p>

    {
      image ? (
        <img
          src={image}
          alt={imageAlt || title}
          class="mt-10 w-full rounded-lg border border-line object-cover"
          loading="lazy"
        />
      ) : (
        <div class="mt-10 flex aspect-[16/9] items-center justify-center rounded-lg border border-line bg-paper-deep">
          <span class="px-4 text-center text-xs uppercase tracking-wide text-ink-soft">
            Image placeholder — add to public/ and set `image` in frontmatter
          </span>
        </div>
      )
    }

    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      <div>
        <p class="eyebrow mb-3">The problem</p>
        <p class="text-sm leading-relaxed text-ink-soft">{problem}</p>
      </div>
      <div>
        <p class="eyebrow mb-3">The approach</p>
        <p class="text-sm leading-relaxed text-ink-soft">{approach}</p>
      </div>
      <div>
        <p class="eyebrow mb-3">My role</p>
        <p class="text-sm leading-relaxed text-ink-soft">{role}</p>
      </div>
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2" aria-label="Technologies">
          {tags.map((tag) => (
            <li class="rounded border border-line px-2.5 py-1 text-xs text-ink-soft">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    {
      links.length > 0 && (
        <div class="mt-10">
          <p class="eyebrow mb-3">Links</p>
          <ul class="flex flex-wrap gap-4">
            {links.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="noopener"
                  target="_blank"
                  class="text-sm font-medium text-accent underline underline-offset-4 hover:text-accent-deep"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      hasBody && (
        <div class="prose-body mt-14 max-w-2xl border-t border-line pt-10 text-base leading-relaxed text-ink-soft">
          <Content />
        </div>
      )
    }
  </article>
</Base>
