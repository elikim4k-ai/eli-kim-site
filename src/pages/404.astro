---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto max-w-4xl px-5 py-32 text-center sm:px-8">
    <p class="eyebrow">404</p>
    <h1
      class="mt-5 font-serif text-4xl font-medium tracking-tight text-ink sm:text-5xl"
    >
      This page <em class="italic text-accent">isn't here</em>.
    </h1>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-accent px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent-deep"
    >
      Back to home
    </a>
  </section>
</Base>
