---
import Base from '../layouts/Base.astro';
import { roles } from '../data/experience';
---

<Base
  title="Experience"
  description="15+ years across quantum, AI/ML, product leadership, and global organisations — Microsoft, United Nations, Samsung, Deel, and more."
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="eyebrow">Experience</p>
    <h1
      class="mt-5 font-serif text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
    >
      Fifteen-plus years, <em class="italic text-accent">end to end</em>.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      From military ICT and the United Nations to Microsoft AI School, quantum
      programmes, and founding my own ventures.
    </p>

    <ol class="mt-14 space-y-0">
      {
        roles.map((role) => (
          <li
            class="grid gap-2 border-t border-line py-8 sm:grid-cols-[10rem_1fr] sm:gap-8"
            data-reveal
          >
            <p class="text-sm text-ink-soft">
              {role.start} — {role.end}
            </p>
            <div>
              <h2 class="font-serif text-xl font-medium text-ink">
                {role.title}
              </h2>
              <p class="mt-1 text-sm font-medium text-accent">
                {role.org}
                {role.location && (
                  <span class="font-normal text-ink-soft">
                    {' '}
                    · {role.location}
                  </span>
                )}
              </p>
              {role.description ? (
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                  {role.description}
                </p>
              ) : (
                <p class="mt-3 text-sm italic text-ink-soft/70">
                  Role details to come.
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
