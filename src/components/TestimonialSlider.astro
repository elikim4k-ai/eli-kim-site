---
import { testimonials } from '../data/testimonials';

const hasPlaceholders = testimonials.some((t) => t.placeholder);
---

<section class="mx-auto max-w-6xl px-5 py-20 sm:px-8" data-reveal>
  <div class="flex flex-wrap items-baseline gap-3">
    <p class="eyebrow">In their words</p>
    {
      hasPlaceholders && (
        <span class="rounded-full border border-line bg-paper-deep px-2.5 py-0.5 text-[11px] uppercase tracking-wide text-ink-soft">
          Placeholder quotes
        </span>
      )
    }
  </div>

  <div class="relative mt-8">
    <div
      id="testimonial-track"
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4"
      style="scrollbar-width: none;"
      aria-roledescription="carousel"
      aria-label="Testimonials"
    >
      {
        testimonials.map((t, i) => (
          <figure
            class="w-[85%] shrink-0 snap-center rounded-lg border border-line bg-white/60 p-8 sm:w-[60%] lg:w-[45%]"
            aria-roledescription="slide"
            aria-label={`Testimonial ${i + 1} of ${testimonials.length}`}
          >
            <blockquote class="font-serif text-lg leading-relaxed text-ink">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-6 text-sm text-ink-soft">
              <span class="font-medium text-ink">{t.name}</span> — {t.role},{' '}
              {t.org}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-2 flex gap-2">
      <button
        type="button"
        data-dir="-1"
        class="testimonial-btn rounded-full border border-line p-2.5 text-ink-soft transition-colors hover:border-accent hover:text-accent"
        aria-label="Previous testimonial"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
      </button>
      <button
        type="button"
        data-dir="1"
        class="testimonial-btn rounded-full border border-line p-2.5 text-ink-soft transition-colors hover:border-accent hover:text-accent"
        aria-label="Next testimonial"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonial-track');
  document.querySelectorAll<HTMLButtonElement>('.testimonial-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!track) return;
      const card = track.querySelector('figure');
      const step = card ? card.getBoundingClientRect().width + 24 : 400;
      track.scrollBy({ left: step * Number(btn.dataset.dir), behavior: 'smooth' });
    });
  });
</script>
