---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, tags, featured, unconfirmed, image, imageAlt } =
  project.data;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-line bg-white/60 transition-shadow hover:shadow-md"
>
  <a href={`/projects/${project.id}/`} class="flex h-full flex-col">
    <div
      class="flex aspect-[16/9] items-center justify-center border-b border-line bg-paper-deep"
    >
      {
        image ? (
          <img
            src={image}
            alt={imageAlt || title}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <span class="px-4 text-center text-xs uppercase tracking-wide text-ink-soft">
            Image placeholder — add to public/ and set `image` in frontmatter
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-6">
      <div class="flex flex-wrap items-center gap-2">
        {
          featured && (
            <span class="rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-medium uppercase tracking-wide text-paper">
              Featured
            </span>
          )
        }
        {
          unconfirmed && (
            <span class="rounded-full border border-line bg-paper-deep px-2.5 py-0.5 text-[11px] uppercase tracking-wide text-ink-soft">
              Draft — unconfirmed
            </span>
          )
        }
      </div>

      <h3
        class="mt-3 font-serif text-xl font-medium text-ink transition-colors group-hover:text-accent"
      >
        {title}
      </h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{tagline}</p>

      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
            {tags.map((tag) => (
              <li class="rounded border border-line px-2 py-0.5 text-xs text-ink-soft">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>
