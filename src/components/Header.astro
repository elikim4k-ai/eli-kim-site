---
import { site, nav, cta } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8"
  >
    <a
      href="/"
      class="font-serif text-lg font-medium tracking-tight text-ink hover:text-accent"
    >
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm transition-colors hover:text-accent',
              isActive(item.href)
                ? 'font-medium text-accent'
                : 'text-ink-soft',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={cta.href}
        class="rounded-full bg-accent px-4 py-2 text-sm font-medium text-paper transition-colors hover:bg-accent-deep"
      >
        {cta.label}
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="rounded p-2 text-ink hover:text-accent lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary mobile"
    class="hidden border-t border-line bg-paper px-5 pb-6 pt-3 lg:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded px-2 py-2.5 text-base hover:bg-paper-deep',
                isActive(item.href)
                  ? 'font-medium text-accent'
                  : 'text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-3">
        <a
          href={cta.href}
          class="block rounded-full bg-accent px-4 py-2.5 text-center text-sm font-medium text-paper hover:bg-accent-deep"
        >
          {cta.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', open);
  });
</script>
