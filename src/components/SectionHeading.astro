---
interface Props {
  eyebrow: string;
  heading?: string;
  /** Heading level for semantics; visual size stays consistent. */
  as?: 'h1' | 'h2';
  class?: string;
}

const { eyebrow, heading, as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  <p class="eyebrow">{eyebrow}</p>
  {
    heading && (
      <Tag class="mt-3 font-serif text-3xl font-medium tracking-tight text-ink sm:text-4xl">
        {heading}
      </Tag>
    )
  }
  <slot />
</div>
